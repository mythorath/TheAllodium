{
  "name": "the-allodium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run db:reset:local && playwright test",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:fixture:local": "wrangler d1 execute DB --local --file=./fixtures/spike_fixture.sql && wrangler d1 execute DB --local --file=./migrations/0002_fts.sql",
    "db:reset:local": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:fixture:local && npm run authority:migrate:local && npm run authority:fixture:local",
    "authority:fixture:local": "wrangler d1 execute AUTHORITY --local --file=./fixtures/authority_browse.sql",
    "db:smoke:local": "tsx scripts/smoke-local.ts",
    "db:create:staging": "tsx scripts/create-staging-d1.ts",
    "db:migrate:staging": "tsx scripts/migrate-staging.ts",
    "db:smoke:staging": "tsx scripts/smoke-staging.ts",
    "db:load:staging-sample": "tsx scripts/load-staging-sample.ts",
    "db:smoke:staging-sample": "tsx scripts/smoke-staging-sample.ts",
    "db:create:production": "tsx scripts/create-production-d1.ts",
    "diff:links": "tsx scripts/diff-snapshot-links.ts",
    "db:promote:staging": "tsx scripts/promote-snapshot.ts --env staging",
    "db:promote:production": "tsx scripts/promote-snapshot.ts --env production --yes",
    "db:rollback:staging": "tsx scripts/rollback-snapshot.ts --env staging --yes",
    "db:rollback:production": "tsx scripts/rollback-snapshot.ts --env production --yes",
    "deploy:staging": "tsx scripts/deploy-worker.ts --env staging",
    "deploy:production": "tsx scripts/deploy-worker.ts --env production --yes",
    "configure:com-redirect": "tsx scripts/configure-com-redirect.ts --yes",
    "configure:gpu-tunnel": "tsx scripts/configure-gpu-tunnel-route.ts --yes",
    "configure:ask-ratelimit": "tsx scripts/configure-ask-ratelimit.ts --yes",
    "promote:og-cards": "tsx scripts/upload-og-cards.ts",
    "promote:og-cards": "tsx scripts/upload-og-cards.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "smoke:gpu": "tsx scripts/smoke-gpu.ts",
    "smoke:og-cards": "tsx scripts/smoke-og-cards.ts",
    "audit:links": "tsx scripts/audit-link-integrity.ts",
    "audit:federation": "tsx scripts/audit-federation-health.ts",
    "verify:browse": "tsx scripts/verify-browse-web.ts",
    "spike:federation": "tsx scripts/spike-federation.ts",
    "spike:federation:edge": "tsx scripts/spike-federation-edge.ts",
    "authority:fetch": "python3 scripts/fetch-authority-sources.py",
    "authority:build": "python3 scripts/build-authority-snapshot.py",
    "authority:migrate:local": "wrangler d1 migrations apply AUTHORITY --local",
    "authority:migrate:staging": "wrangler d1 migrations apply AUTHORITY --env staging --remote",
    "authority:migrate:production": "wrangler d1 migrations apply AUTHORITY --env production --remote",
    "authority:promote:staging": "tsx scripts/promote-authority.ts --env staging",
    "authority:promote:production": "tsx scripts/promote-authority.ts --env production --yes",
    "authority:rollback:staging": "tsx scripts/rollback-authority.ts --env staging --yes",
    "authority:rollback:production": "tsx scripts/rollback-authority.ts --env production --yes",
    "authority:publish:r2": "tsx scripts/publish-authority-dump.ts",
    "authority:publish:zenodo": "tsx scripts/publish-authority-zenodo.ts",
    "gate:1a": "tsx scripts/close-1a-gate.ts",
    "gate:1c": "tsx scripts/close-1c-gate.ts",
    "gate:1d": "tsx scripts/close-1d-gate.ts",
    "gate:1e": "tsx scripts/close-1e-gate.ts",
    "gate:1f": "tsx scripts/close-1f-gate.ts",
    "gate:2a": "tsx scripts/close-2a-gate.ts",
    "gate:2b": "tsx scripts/close-2b-gate.ts",
    "gate:2c": "tsx scripts/close-2c-gate.ts",
    "gate:2d": "tsx scripts/close-2d-gate.ts",
    "gate:2e": "tsx scripts/close-2e-gate.ts",
    "gate:25a": "tsx scripts/close-25a-gate.ts",
    "gate:25b": "tsx scripts/close-25b-gate.ts",
    "gate:25c": "tsx scripts/close-25c-gate.ts",
    "gate:25d": "tsx scripts/close-25d-gate.ts",
    "gate:3a": "tsx scripts/close-3a-gate.ts",
    "gate:3b": "tsx scripts/close-3b-gate.ts",
    "gate:3c": "tsx scripts/close-3c-gate.ts",
    "gate:5a": "tsx scripts/close-5-gate.ts 5a",
    "gate:5b": "tsx scripts/close-5-gate.ts 5b",
    "gate:5c": "tsx scripts/close-5-gate.ts 5c",
    "gate:5d": "tsx scripts/close-5-gate.ts 5d",
    "gate:5e": "tsx scripts/close-5-gate.ts 5e",
    "gate:5f": "tsx scripts/close-5-gate.ts 5f",
    "gate:5g": "tsx scripts/close-5-gate.ts 5g",
    "gate:5h": "tsx scripts/close-5-gate.ts 5h",
    "gate:5": "tsx scripts/close-5-gate.ts all",
    "secrets:scan": "tsx scripts/secrets-scan.ts"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.11.0",
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@cloudflare/workers-types": "^4.20250801.0",
    "@customcommander/ris": "^5.1.2",
    "@playwright/test": "^1.62.1",
    "@retorquere/bibtex-parser": "^10.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.34.0"
  }
}
