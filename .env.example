# Copy to .env and fill in. Never commit .env.
#
# Minimum (Phases 1A-1E): Account -> D1 -> Edit.
#
# Phase 1F (deploy:production, configure:com-redirect) additionally needs,
# scoped to theallodium.org and theallodium.com specifically (Account
# permissions never imply Zone permissions -- they're independent scopes):
#   Account -> Workers Scripts -> Edit
#   Zone -> Workers Routes -> Edit       (theallodium.org)
#   Zone -> Zone -> Read                 (both)
#   Zone -> Single Redirect -> Edit      (theallodium.com)
#   Zone -> DNS -> Edit                  (theallodium.com -- a zone with
#     zero DNS records has no hostname for Cloudflare's edge to route
#     requests to at all, so configure-com-redirect.ts also provisions a
#     placeholder proxied record there)

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional R2 credentials (not required for Phase 1A)
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
