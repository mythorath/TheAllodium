{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theallodium",
  "main": "src/index.tsx",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Local / default: placeholder UUID until staging DB is created.
  // Remote staging ID is written by scripts/create-staging-d1.ts into the
  // "staging" environment below — never put API tokens here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "theallodium-psychotherapy-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    },
    {
      "binding": "AUTHORITY",
      "database_name": "theallodium-authority-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "authority-migrations"
    },
    {
      // Test-only minerals example. Never added to staging/production.
      "binding": "COLLECTION_MINERALS",
      "database_name": "theallodium-minerals-local",
      "database_id": "00000000-0000-0000-0000-000000000003",
      "migrations_dir": "collection-migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SEARCH_CACHE",
      "id": "25fdf4524df941c6946e195b9bba3920"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "UPSTREAM_RATE_LIMITER",
        "class_name": "UpstreamRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UpstreamRateLimiter"]
    }
  ],
  // Phase 2E: OpenGraph card PNGs, content-addressed by
  // {checksum}/{entry id}.png -- see scripts/upload-og-cards.ts and the
  // GET /og/:filename route in src/index.tsx. vitest-pool-workers reads
  // bindings straight from this file (see vitest.config.ts), so R2 is
  // simulated locally in tests automatically once this binding exists.
  "r2_buckets": [
    {
      "binding": "OG_CARDS",
      "bucket_name": "theallodium-og-cards-local"
    }
  ],
  "env": {
    "staging": {
      "name": "theallodium-staging",
      // Phase 3A: Worker-side GPU origin. Local/default stays unset so
      // tests never hit the live tunnel. pingGpu() is not called from
      // routes yet — 3B wires ?ask=.
      "vars": {
        "GPU_ORIGIN": "https://gpu.theallodium.org"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "theallodium-psychotherapy-staging",
          // Replaced by create-staging-d1.ts after wrangler d1 create
          "database_id": "b3ded3ce-abf6-499f-acfd-ba35ea869313",
          "migrations_dir": "migrations"
        },
        {
          "binding": "AUTHORITY",
          "database_name": "theallodium-authority-staging",
          "database_id": "cbb01c39-7900-40d9-969b-01bf977ceab8",
          "migrations_dir": "authority-migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SEARCH_CACHE",
          "id": "25fdf4524df941c6946e195b9bba3920"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "UPSTREAM_RATE_LIMITER",
            "class_name": "UpstreamRateLimiter"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "OG_CARDS",
          "bucket_name": "theallodium-og-cards-staging"
        }
      ]
    },
    "production": {
      "name": "theallodium-production",
      "vars": {
        "GPU_ORIGIN": "https://gpu.theallodium.org"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "theallodium-psychotherapy-production",
          // Written by create-production-d1.ts after wrangler d1 create
          "database_id": "f476d24a-c84d-4234-b080-fb22215a283e",
          "migrations_dir": "migrations"
        },
        {
          "binding": "AUTHORITY",
          "database_name": "theallodium-authority-production",
          "database_id": "5c3d5d68-1dab-4ef3-89d2-0c57a5cd6261",
          "migrations_dir": "authority-migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SEARCH_CACHE",
          "id": "37bd47f22ca649e5aab52102751affeb"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "UPSTREAM_RATE_LIMITER",
            "class_name": "UpstreamRateLimiter"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "OG_CARDS",
          "bucket_name": "theallodium-og-cards-production"
        }
      ],
      // Phase 1F: Custom Domain, not a raw Route -- this Worker is the sole
      // origin for the whole zone. Cloudflare provisions DNS + TLS on deploy.
      "routes": [{ "pattern": "theallodium.org", "custom_domain": true }]
    }
  }
}
